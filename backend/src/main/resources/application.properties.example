# Copy this file to application.properties and supply real values

db.url=jdbc:mysql://localhost:3306/food_delivery_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
db.user=your_db_username
db.password=your_db_password

db.pool.maxSize=20
db.pool.minIdle=5
db.pool.timeout=30000

server.port=8081

jwt.secret=
# Required: generate a unique random secret of at least 32 bytes.
jwt.expirationMillis=900000
jwt.refreshTokenExpirationMillis=604800000

razorpay.keyId=
razorpay.keySecret=
razorpay.webhookSecret=

cors.allowedOrigins=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

dispatch.maxSearchRadiusKm=7.0
dispatch.riderAcceptTimeoutSeconds=30
dispatch.fairPayBaseFare=35.00
dispatch.fairPayPerKmRate=12.00
