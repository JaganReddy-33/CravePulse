# ==============================================================================
# CravePulse Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=8081
NODE_ENV=production

# Database Credentials
DB_URL=jdbc:mysql://localhost:3306/food_delivery_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USER=root
DB_PASSWORD=your_secure_db_password_here
DB_NAME=food_delivery_db

# Security & JWT Tokens
JWT_SECRET=your_jwt_signing_secret_min_64_characters_long_random_string!
JWT_EXPIRATION_MILLIS=900000
JWT_REFRESH_EXPIRATION_MILLIS=604800000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Payment Gateway (Razorpay Sandbox)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
