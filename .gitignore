# ==============================================================================
# ENVIRONMENT, SECRETS & CREDENTIALS (CRITICAL - NEVER PUSH TO GITHUB)
# ==============================================================================
# Environment variable files
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
!*.env.example
!**/*.env.example
!**/.env.example

# Sensitive Java & Spring/Tomcat properties
application.properties
**/application.properties
application-*.properties
**/application-*.properties
db.properties
**/db.properties
*.properties.local
**/*.properties.local
!application.properties.example
!**/application.properties.example

# Private Keys, Certificates & Tokens
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*credentials*.json
*secret*.json
!*credentials*.example.json
!*secret*.example.json

